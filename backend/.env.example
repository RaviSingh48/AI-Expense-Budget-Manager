APP_NAME="AI Expense & Budget Manager"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration
# Option A: SQLite (Default for quick local development — zero setup required)
DATABASE_URL="sqlite:///./data/expense_tracker.db"
TEST_DATABASE_URL="sqlite:///./data/expense_tracker_test.db"

# Option B: PostgreSQL (Recommended for production)
# DATABASE_URL="postgresql+psycopg2://expense_user:your_password@localhost:5432/expense_tracker"
# TEST_DATABASE_URL="postgresql+psycopg2://expense_user:your_password@localhost:5432/expense_tracker_test"

# JWT Security
SECRET_KEY="replace_with_a_secure_random_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vector DB Configuration
CHROMA_DB_DIR="./vector_store/chroma_db"
CHROMA_COLLECTION_NAME="expense_vectors"

# Gemini API Configuration (Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000"
